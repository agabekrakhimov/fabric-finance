table DateTable
	lineageTag: t-datetable
	isHidden

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: c-date
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		lineageTag: c-year
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column MonthNumber
		dataType: int64
		lineageTag: c-monthnumber
		summarizeBy: none
		sourceColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	column MonthName
		dataType: string
		lineageTag: c-monthname
		summarizeBy: none
		sourceColumn: MonthName

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: c-quarter
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source =
			ADDCOLUMNS(
				CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),
				"Year",        YEAR([Date]),
				"MonthNumber", MONTH([Date]),
				"MonthName",   FORMAT([Date], "MMMM"),
				"Quarter",     "Q" & QUARTER([Date])
			)
